// Schema pronto para SQLite (dev/local) e Postgres/Supabase (produção).
// Para produção: troque provider para "postgresql" e use a DATABASE_URL do Supabase.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Lead {
  id              String    @id @default(cuid())
  firstName       String
  lastName        String
  email           String
  whatsapp        String
  scheduledDate   DateTime
  status          String    @default("NOVO")
  notes           Note[]
  timeline        Timeline[] @relation("LeadTimeline")
  source          String?   @default("landing-page")
  ip              String?
  appointmentTime String?
  appointmentType String?   @default("Pedido de contacto")
  company         String?
  spaceType       String?
  planName        String?
  // Conversão
  convertedAt     DateTime?
  convertedBy     String?
  companyRef      Company?  @relation("LeadSource", fields: [leadCompanyId], references: [id], onDelete: SetNull)
  leadCompanyId   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([scheduledDate])
  @@index([createdAt])
  @@index([leadCompanyId])
}

model RoomBookingLead {
  id              String       @id @default(cuid())
  firstName       String
  lastName        String
  company         String?
  email           String
  whatsapp        String
  planName        String
  participants    Int?
  preferredDate   DateTime?
  preferredTime   String?
  observations    String?
  coffeeBreak     Boolean      @default(false)
  status          String       @default("NOVO")
  source          String       @default("landing-sala")
  ip              String?
  companyId       String?
  companyRef      Company?     @relation("RoomLeadCompany", fields: [companyId], references: [id], onDelete: SetNull)
  reservationId   String?
  convertedAt     DateTime?
  convertedBy     String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([planName])
  @@index([companyId])
}

model Note {
  id        String   @id @default(cuid())
  content   String
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

enum AdminRole {
  ADMIN
  COMERCIAL
  FINANCEIRO
  VIEWER
}

model AdminUser {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  name         String?
  role         AdminRole      @default(VIEWER)
  totpSecret   String?
  totpEnabled  Boolean        @default(false)
  active       Boolean        @default(true)
  lastLoginAt  DateTime?                         // VOL05-2: actualizado em cada login bem-sucedido
  lastLoginIp  String?                           // VOL05-2: IP do último login
  createdAt    DateTime       @default(now())
  crmAssignedCompanies  Company[]      @relation("CrmAssignee")
  sessions     AdminSession[]                    // VOL05-2: sessões activas rastreadas
}

// ─────────────────────────────────────────────────────────────────────────────
// VOL05 — Audit Log
// Registo imutável de todas as operações críticas do sistema.
// Política de retenção: 365 dias activo → arquivo (ver ADR-035).
// ─────────────────────────────────────────────────────────────────────────────

enum AuditAction {
  // Auth
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  TOTP_ENABLED
  TOTP_DISABLED
  TOTP_VERIFY_FAILED
  SESSION_REVOKED
  // Utilizadores admin
  ADMIN_USER_CREATED
  ADMIN_USER_UPDATED
  ADMIN_USER_DELETED
  ADMIN_USER_DEACTIVATED
  ADMIN_USER_REACTIVATED
  ADMIN_PASSWORD_CHANGED
  // Financeiro
  PAYMENT_CREATED
  PAYMENT_CONFIRMED
  PAYMENT_UPDATED
  PAYMENT_CANCELLED
  INVOICE_CREATED
  INVOICE_SENT
  INVOICE_CANCELLED
  // Reservas
  RESERVATION_CREATED
  RESERVATION_UPDATED
  RESERVATION_STATUS_CHANGED
  RESERVATION_CANCELLED
  // Configurações
  ROOM_SETTINGS_UPDATED
  PLAN_CREATED
  PLAN_UPDATED
  PLAN_DELETED
  PRICING_UPDATED
  // Gestão Documental (VOL08)
  DOCUMENT_GENERATED
  DOCUMENT_DOWNLOADED
  DOCUMENT_SHARED_PORTAL
}

/// Sessões administrativas activas — VOL05-2.
/// tokenHash = SHA-256(JWT). Permite revogar sessões individuais sem invalidar JWT_SECRET.
model AdminSession {
  id           String    @id @default(cuid())
  adminUserId  String
  tokenHash    String    @unique            // SHA-256 do JWT — nunca guardar JWT em bruto
  ipAddress    String?
  userAgent    String?
  lastActiveAt DateTime  @default(now())
  expiresAt    DateTime
  isRevoked    Boolean   @default(false)
  createdAt    DateTime  @default(now())

  adminUser    AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId, isRevoked])
  @@index([tokenHash])
  @@index([expiresAt])
}

/// Registo de auditoria imutável. Nunca actualizar nem eliminar registos.
/// Campos before/after são sempre sanitizados (sem passwordHash, totpSecret, tokenHash).
model AuditLog {
  id         String      @id @default(cuid())
  actorId    String      // AdminUser.id | "SYSTEM" | "UNKNOWN"
  actorRole  String      // AdminRole | "SYSTEM" | "UNKNOWN"
  actorEmail String      // denormalizado — preservado mesmo se user for eliminado
  action     AuditAction
  entity     String      // "Payment" | "Reservation" | "AdminUser" | ...
  entityId   String      // id da entidade afectada
  entityRef  String?     // referência legível: "RES-2026-000001", email, etc.
  before     Json?       // estado anterior sanitizado (sem campos sensíveis)
  after      Json?       // estado posterior sanitizado
  ipAddress  String?
  userAgent  String?
  metadata   Json?       // contexto livre: reason, channel, etc.
  createdAt  DateTime    @default(now())

  @@index([actorId, createdAt])
  @@index([entity, entityId])
  @@index([action, createdAt])
  @@index([createdAt])
}

model DeleteRequest {
  id          String   @id @default(cuid())
  requestedBy String
  entityType  String
  entityId    String
  entityLabel String
  reason      String
  status      String   @default("PENDING")
  reviewedBy  String?
  reviewNote  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Company {
  id                String             @id @default(cuid())
  name              String
  nif               String?
  responsible       String
  email             String
  whatsapp          String
  roomNumber        String
  numEmployees      Int                @default(1)
  planType          String
  contractStart     DateTime
  contractEnd       DateTime
  rentAmount        Float
  paymentFrequency  String             @default("MENSAL")
  contractStatus    String             @default("ATIVO")
  paymentStatus     String             @default("EM_DIA")
  contractFileUrl   String?
  notes             String?
  leadSourceId      String?
  payments          Payment[]
  invoices          Invoice[]
  financialHistory  FinancialHistory[]
  reservations      Reservation[]
  timeline          Timeline[]
  liquidationNotes  LiquidationNote[]
  employees         Employee[]
  leadSources       Lead[]             @relation("LeadSource")
  roomBookingLeads  RoomBookingLead[]  @relation("RoomLeadCompany")
  // ── CRM fields (Volume 01) ───────────────────────────────────────────────
  crmStatus         CompanyStatus?
  pipelineStage     PipelineStage?
  assignedToId      String?
  assignedTo        AdminUser?         @relation("CrmAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  website           String?
  sector            String?
  country           String?            @default("Angola")
  mergedIntoId      String?
  crmDeletedAt      DateTime?
  // CRM relations
  crmContacts       CrmContact[]
  crmDeals          CrmDeal[]
  crmActivities     CrmActivity[]
  crmTasks          CrmTask[]
  crmNotes          CrmNote[]
  companyTags       CompanyTag[]
  crmTimeline       TimelineEntry[]
  crmAuditLogs      CrmAuditLog[]
  // ── ERP fields (Volume 02) ───────────────────────────────────────────────
  billingEmail      String?            // email preferencial para faturas ERP
  // ERP relations
  erpContracts      ErpContract[]
  erpRentSchedules  ErpRentSchedule[]
  erpInvoices       ErpInvoice[]
  erpPayments       ErpPayment[]
  financialLedger   FinancialLedger[]
  erpExpenses       ErpExpense[]
  financialAlerts   FinancialAlert[]
  // ── Portal relations (Volume 03) ─────────────────────────────────────────
  portalUsers           PortalUser[]
  portalDocuments       PortalDocument[]
  portalNotifications   PortalNotification[]
  portalSupportTickets  PortalSupportTicket[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([contractStatus])
  @@index([contractEnd])
  // CRM indexes (Volume 01)
  @@index([crmStatus])
  @@index([pipelineStage])
  @@index([assignedToId])
  @@index([crmDeletedAt])
}



model Payment {
  id              String    @id @default(cuid())
  companyId       String?
  company         Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reservationId   String?   // link to sala reservation (optional)
  dueDate         DateTime
  paidDate        DateTime?
  amount          Float
  status          String    @default("PENDENTE")
  notes           String?
  invoiceId       String?
  paymentMethod   String?
  receiptUrl      String?   // doc 1 — comprovativo
  doc2Url         String?   // doc 2 — opcional
  category        String?
  receiptNumber   String?   // REC-YYYY-NNNNNN gerado automaticamente
  operationRef    String?   // referência bancária / multicaixa / POS
  previousBalance Float?    // saldo antes deste pagamento (auditoria)
  createdAt       DateTime  @default(now())

  @@index([companyId])
  @@index([status])
  @@index([dueDate])
  @@index([receiptNumber])
  @@index([reservationId])
}

model Invoice {
  id              String           @id @default(cuid())
  invoiceNumber   String           @unique
  companyId       String?
  company         Company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reservationId   String?          // link to sala reservation (optional)
  serviceType     String
  amount          Float
  discount        Float            @default(0)
  iva             Float            @default(0)  // percentage
  totalAmount     Float            @default(0)
  amountPaid      Float            @default(0)
  balance         Float            @default(0)
  paidPercentage  Float            @default(0)
  issueDate       DateTime         @default(now())
  dueDate         DateTime
  paymentMethod   String?
  status          String           @default("PENDENTE")
  // PENDENTE | PARCIAL | LIQUIDADA | EM_ATRASO | PAGO
  receiptUrl      String?
  notes           String?
  invoicePayments InvoicePayment[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([companyId])
  @@index([status])
  @@index([dueDate])
  @@index([reservationId])
}

model InvoicePayment {
  id            String   @id @default(cuid())
  invoiceId     String
  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount        Float
  paymentMethod String?
  operationRef  String?
  receiptUrl    String?
  paidDate      DateTime @default(now())
  createdBy     String?
  createdAt     DateTime @default(now())

  @@index([invoiceId])
}

model LiquidationNote {
  id            String   @id @default(cuid())
  noteNumber    String   @unique
  invoiceId     String?
  reservationId String?
  companyId     String?
  company       Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  amountBilled  Float
  amountPaid    Float
  balance       Float
  paymentMethod String?
  operationRef  String?
  createdBy     String?
  createdAt     DateTime @default(now())

  @@index([invoiceId])
  @@index([companyId])
}

model FinancialAudit {
  id          String   @id @default(cuid())
  action      String
  entityType  String
  entityId    String
  companyId   String?
  amount      Float?
  method      String?
  reference   String?
  createdBy   String?
  ip          String?
  createdAt   DateTime @default(now())

  @@index([entityId])
  @@index([companyId])
  @@index([createdAt])
}

model FinancialHistory {
  id             String   @id @default(cuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type           String   // PAGAMENTO | FATURA | AJUSTE | NOTA
  description    String
  amount         Float
  runningBalance Float    @default(0)
  method         String?
  reference      String?  // paymentId or invoiceId
  createdBy      String?
  createdAt      DateTime @default(now())

  @@index([companyId])
  @@index([createdAt])
}

model Expense {
  id          String   @id @default(cuid())
  category    String
  description String
  amount      Float
  expenseDate DateTime
  supplier    String?
  status      String   @default("PAGO")
  receiptUrl  String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([expenseDate])
}

model RevenueCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model MeetingPlan {
  id                    String        @id @default(cuid())
  name                  String
  maxPeople             Int
  description           String?
  coffeeBreakAvailable  Boolean       @default(true)
  customPricingAllowed  Boolean       @default(false)
  minHoursForCustom     Int?          @default(16)
  pricePerHour          Float         @default(0)
  coffeeBreakPrice      Float         @default(0)
  halfDayPrice          Float         @default(0)   // 4h flat price
  fullDayPrice          Float         @default(0)   // 8h flat price
  weekendPrice          Float         @default(0)   // weekend flat price
  promoPrice            Float         @default(0)   // promotional price
  active                Boolean       @default(true)
  reservations          Reservation[]
  createdAt             DateTime      @default(now())
}

model Reservation {
  id                String      @id @default(cuid())
  reservationNumber String?     // RES-YYYY-NNNNNN

  // Dados do cliente
  eventName         String
  companyName       String?     // free-text (external clients)
  companyId         String?     // link to Company (coworking members)
  company           Company?    @relation(fields: [companyId], references: [id], onDelete: SetNull)
  responsible       String
  email             String?
  whatsapp          String?

  // Plano e horário
  planId            String
  plan              MeetingPlan @relation(fields: [planId], references: [id])
  participants      Int
  startDatetime     DateTime
  endDatetime       DateTime
  totalHours        Float
  coffeeBreak       Boolean     @default(false)
  observations      String?

  // Estado da reserva
  status            String      @default("CONFIRMADA")
  // CONFIRMADA | RESERVADO | PENDENTE_APROVACAO | CANCELADA | CONCLUIDA
  isCustomPricing   Boolean     @default(false)
  customRequest     String?

  // Financeiro
  paymentOption     String      @default("PAGAR_NO_DIA")
  // PAGAR_AGORA | PAGAR_NO_DIA | FACTURAR | ISENTO
  amount            Float       @default(0)   // base (hours × pricePerHour + coffeeBreak)
  discount          Float       @default(0)   // discount amount
  iva               Float       @default(0)   // IVA % (e.g. 14)
  totalAmount       Float       @default(0)   // final amount
  paymentStatus     String      @default("PENDENTE")
  // PAGO | PENDENTE | FACTURADO | ISENTO
  paymentMethod     String?
  operationRef      String?
  receiptUrl        String?
  financialNotes    String?
  amountPaid        Float       @default(0)   // amount paid so far (partial support)
  paidDate          DateTime?                  // date of payment

  // Linked financial records
  paymentId         String?
  invoiceId         String?
  roomBookingLeadId String?

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([planId])
  @@index([companyId])
  @@index([startDatetime])
  @@index([status])
  @@index([paymentStatus])
  @@index([reservationNumber])
}

model Timeline {
  id            String   @id @default(cuid())
  companyId     String?
  company       Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  leadId        String?
  lead          Lead?    @relation("LeadTimeline", fields: [leadId], references: [id], onDelete: SetNull)
  type          String
  title         String
  description   String?
  amount        Float?
  referenceId   String?
  referenceType String?
  createdBy     String?
  createdAt     DateTime @default(now())

  @@index([companyId])
  @@index([leadId])
  @@index([createdAt])
}

model RoomPricing {
  id              String   @id @default(cuid())
  roomId          String   @default("sala-reuniao")
  label           String                             // "1 Hora", "Meio Período", "Dia Inteiro"
  durationMinutes Int                                // 60, 120, 240, 480
  price           Float                              // 15000, 28000, 50000, 90000
  currency        String   @default("AOA")
  active          Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([roomId])
  @@index([durationMinutes])
  @@index([active])
}

model RoomSettings {
  id                  String   @id @default(cuid())
  defaultPricePerHour Float    @default(15000)
  defaultHalfDay      Float    @default(50000)
  defaultFullDay      Float    @default(90000)
  defaultWeekend      Float    @default(120000)
  defaultIva          Float    @default(0)
  maxDiscount         Float    @default(100)
  currency            String   @default("AOA")
  openTime            String   @default("08:00")
  closeTime           String   @default("18:00")
  minHours            Float    @default(1)
  maxHours            Float    @default(12)
  updatedAt           DateTime @updatedAt
  updatedBy           String?
}

model Employee {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  role        String
  department  String?
  phone       String?
  email       String?
  startDate   DateTime?
  status      String    @default("ATIVO")  // ATIVO | INATIVO | AFASTADO
  notes       String?
  photoUrl    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([companyId])
  @@index([status])
}

// ── Contador atómico de numeração de documentos ──────────────────────────────
// Elimina race condition de `count + 1` em documentos financeiros (DT-014).
// Uso: nextDocumentNumber(tx, "FT-SALA") → "FT-SALA-2026-000001"
model DocumentCounter {
  id      String @id @default(cuid())
  type    String // FT-SALA | FT-CWORK | REC | NL | RES
  year    Int
  lastSeq Int    @default(0)

  @@unique([type, year])
  @@index([type, year])
}

model Notification {
  id          String    @id @default(cuid())
  type        String    // INFO | WARNING | ERROR | SUCCESS
  title       String
  message     String
  entityType  String?   // Lead | Reservation | Payment | Company | Employee
  entityId    String?
  companyId   String?
  read        Boolean   @default(false)
  readAt      DateTime?
  priority    String    @default("NORMAL")  // LOW | NORMAL | HIGH | URGENT
  createdAt   DateTime  @default(now())

  @@index([read])
  @@index([createdAt])
  @@index([companyId])
  @@index([priority])
}

// ═══════════════════════════════════════════════════════════════════════════════
// VOLUME 07 — COMUNICAÇÃO AVANÇADA
// Docs: docs/10-comunicacao/README.md
// ═══════════════════════════════════════════════════════════════════════════════

enum CommType {
  EMAIL
  WHATSAPP
  WHATSAPP_DEEPLINK
}

enum CommStatus {
  PENDING
  SENT
  FAILED
  RETRYING
}

model CommunicationLog {
  id            String     @id @default(cuid())
  type          CommType
  channel       String     // transactional | alert | reminder | receipt
  templateSlug  String?
  to            String
  subject       String?
  body          String     @db.Text
  status        CommStatus @default(PENDING)
  attempts      Int        @default(0)
  lastAttemptAt DateTime?
  sentAt        DateTime?
  errorMsg      String?
  entityType    String?    // LEAD | COMPANY | RESERVATION | PAYMENT | INVOICE
  entityId      String?
  triggeredBy   String     @default("SYSTEM")
  adminId       String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([status])
  @@index([type])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([to])
}

model EmailTemplate {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  subject   String
  htmlBody  String   @db.Text
  variables String[]
  category  String   // transactional | financial | alert
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ═══════════════════════════════════════════════════════════════════════════════
// VOLUME 01 — CRM

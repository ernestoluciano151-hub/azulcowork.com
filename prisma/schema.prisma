// ── Modelos ERP ──────────────────────────────────────────────────────────────

/// Contrato de aluguer de posto de coworking.
/// ADR-022: entidade central do módulo de receita recorrente.
/// Activação gera ErpRentSchedule[] automaticamente.
model ErpContract {
  id                 String           @id @default(cuid())
  companyId          String
  company            Company          @relation(fields: [companyId], references: [id])
  planType           ContractPlanType
  startDate          DateTime
  endDate            DateTime?
  monthlyValue       Float            // AOA
  depositAmount      Float            @default(0)
  depositStatus      DepositStatus    @default(PENDING)
  depositPaidAt      DateTime?
  depositReturnedAt  DateTime?
  status             ContractStatus   @default(DRAFT)
  autoRenew          Boolean          @default(false)
  renewalNoticeDays  Int              @default(30)
  adjustmentRules    Json?            // { type: "IPC", rate: 0.05, frequency: "ANNUAL" }
  notes              String?
  attachments        String[]         // Cloudinary URLs de PDFs assinados
  signedAt           DateTime?
  terminatedAt       DateTime?
  terminationReason  String?
  createdBy          String           // AdminUser.id
  updatedBy          String?
  deletedAt          DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  rentSchedules      ErpRentSchedule[]
  erpInvoices        ErpInvoice[]

  @@index([companyId])
  @@index([status])
  @@index([endDate])
}

/// Parcela mensal gerada automaticamente pela activação de um ErpContract.
/// Regra BR-CONT-001: dueDate = dia 1 do mês.
/// Regra BR-CONT-002: status OVERDUE definido pelo cron diário.
model ErpRentSchedule {
  id           String             @id @default(cuid())
  contractId   String
  contract     ErpContract        @relation(fields: [contractId], references: [id])
  companyId    String
  company      Company            @relation(fields: [companyId], references: [id])
  dueDate      DateTime
  amount       Float              // AOA — igual a Contract.monthlyValue na geração
  status       RentScheduleStatus @default(PENDING)
  invoiceId    String?            @unique
  invoice      ErpInvoice?        @relation(fields: [invoiceId], references: [id])
  waivedAt     DateTime?
  waivedBy     String?
  waivedReason String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([contractId])
  @@index([companyId])
  @@index([dueDate])
  @@index([status])
}

/// Fatura ERP unificada (coworking + salas + serviços).
/// Nomenclatura: FT-CWORK-YYYY-NNNNNN | FT-SALA-YYYY-NNNNNN | FT-SERV-YYYY-NNNNNN
/// ADR-023: separada do modelo legado Invoice (coworking clássico).
model ErpInvoice {
  id            String           @id @default(cuid())
  number        String           @unique // FT-CWORK-2026-000001
  type          ErpInvoiceType
  companyId     String?
  company       Company?         @relation(fields: [companyId], references: [id])
  bookingId     String?          // Reservation.id (sala de reunião)
  contractId    String?
  contract      ErpContract?     @relation(fields: [contractId], references: [id])
  status        ErpInvoiceStatus @default(DRAFT)
  issueDate     DateTime         @default(now())
  dueDate       DateTime
  subtotal      Float            // AOA sem IVA
  taxRate       Float            @default(0.14) // 14% — Lei 17/19 Angola
  taxAmount     Float            // AOA
  total         Float            // AOA = subtotal + taxAmount
  pdfUrl        String?          // Cloudinary
  sentAt        DateTime?
  sentTo        String?          // email destinatário
  paidAt        DateTime?
  notes         String?
  voidedAt      DateTime?
  voidedBy      String?
  voidReason    String?
  createdBy     String           // AdminUser.id
  updatedBy     String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  items           ErpInvoiceItem[]
  erpPayments     ErpPayment[]
  rentSchedule    ErpRentSchedule?
  ledgerEntries   FinancialLedger[]

  @@index([companyId])
  @@index([status])
  @@index([dueDate])
  @@index([type])
  @@index([number])
}

/// Item de linha de uma fatura ERP.
/// accountCode: código do plano de contas PGC Angola (ex.: "7111").
model ErpInvoiceItem {
  id           String      @id @default(cuid())
  invoiceId    String
  invoice      ErpInvoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description  String
  quantity     Float       @default(1)
  unitPrice    Float       // AOA
  total        Float       // AOA = quantity * unitPrice
  accountCode  String      // PGC Angola (ex.: "7111", "7121")
  costCenterId String?
  costCenter   CostCenter? @relation(fields: [costCenterId], references: [id])
  createdAt    DateTime    @default(now())

  @@index([invoiceId])
}

/// Pagamento ERP — confirmado por ADMIN após validação de comprovativo.
/// ADR-023: separado do modelo legado Payment.
/// Confirmação gera FinancialLedger + CashMovement + Recibo.
model ErpPayment {
  id            String          @id @default(cuid())
  invoiceId     String?
  invoice       ErpInvoice?     @relation(fields: [invoiceId], references: [id])
  companyId     String?
  company       Company?        @relation(fields: [companyId], references: [id])
  amount        Float           // AOA
  method        ErpPaymentMethod
  reference     String?         // referência bancária / n.º operação Multicaixa / POS
  paidAt        DateTime
  confirmedAt   DateTime?
  confirmedBy   String?         // AdminUser.id
  status        ErpPaymentStatus @default(PENDING)
  receiptUrl    String?         // Cloudinary PDF
  receiptNumber String?         // REC-2026-000001
  notes         String?
  createdBy     String          // AdminUser.id
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  ledgerEntries FinancialLedger[]

  @@index([invoiceId])
  @@index([companyId])
  @@index([status])
  @@index([paidAt])
}

/// Razão Geral Financeiro — IMUTÁVEL (append-only).
/// ADR-021: NUNCA executar UPDATE ou DELETE nesta tabela.
/// Correcções via estorno: novo lançamento com sinal contrário + campo reverses.
/// Implementa partida dupla: toda operação cria par DEBIT + CREDIT.
model FinancialLedger {
  id           String      @id @default(cuid())
  entryDate    DateTime
  description  String
  type         LedgerType
  amount       Float       // AOA — sempre positivo
  accountCode  String      // PGC Angola (ex.: "1201", "2111", "7111")
  costCenterId String?
  costCenter   CostCenter? @relation(fields: [costCenterId], references: [id])
  companyId    String?
  company      Company?    @relation(fields: [companyId], references: [id])
  invoiceId    String?
  invoice      ErpInvoice? @relation(fields: [invoiceId], references: [id])
  paymentId    String?
  payment      ErpPayment? @relation(fields: [paymentId], references: [id])
  expenseId    String?
  expense      ErpExpense? @relation(fields: [expenseId], references: [id])
  reference    String      @unique // identificador único do lançamento
  reverses     String?     // FinancialLedger.id do lançamento revertido
  createdBy    String      // AdminUser.id ou "SYSTEM"
  createdAt    DateTime    @default(now())
  // SEM updatedAt — imutável por design (ADR-021)

  @@index([accountCode])
  @@index([entryDate])
  @@index([companyId])
  @@index([costCenterId])
  @@index([type])
}

/// Categoria de despesa operacional.
/// accountCode: conta da classe 6 do PGC Angola (ex.: "6111").
model ExpenseCategory {
  id          String      @id @default(cuid())
  name        String      @unique
  accountCode String      // PGC Angola classe 6
  description String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())

  expenses    ErpExpense[]
}

/// Despesa operacional do Azul Coworking.
/// ADR: separado do modelo legado Expense (simplificado).
/// Aprovação obrigatória para amount > Kz 50.000 (BR-FIN-008).
model ErpExpense {
  id             String            @id @default(cuid())
  categoryId     String
  category       ExpenseCategory   @relation(fields: [categoryId], references: [id])
  costCenterId   String?
  costCenter     CostCenter?       @relation(fields: [costCenterId], references: [id])
  supplierName   String?
  supplierNif    String?           // activa IVA dedutível (conta 2312)
  description    String
  amount         Float             // AOA
  dueDate        DateTime
  paidAt         DateTime?
  status         ErpExpenseStatus  @default(PENDING)
  recurrence     ExpenseRecurrence @default(NONE)
  receiptUrl     String?           // Cloudinary — doc de suporte
  approvedBy     String?           // AdminUser.id
  approvedAt     DateTime?
  rejectedBy     String?
  rejectedReason String?
  notes          String?
  deletedAt      DateTime?
  createdBy      String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  ledgerEntries  FinancialLedger[]
  company        Company?          @relation(fields: [companyId], references: [id])
  companyId      String?

  @@index([categoryId])
  @@index([costCenterId])
  @@index([status])
  @@index([dueDate])
}

/// Centro de custo analítico — estrutura plana (ADR-024).
/// Atribuído a InvoiceItems, Expenses e FinancialLedger entries.
model CostCenter {
  id          String    @id @default(cuid())
  code        String    @unique // OPERACIONAL | RH | MARKETING | TI | ADMIN | FINANCEIRO | COWORKING | SALAS | SERVICOS
  name        String
  description String?
  isActive    Boolean   @default(true)
  budget      Float?    // orçamento mensal AOA (null = sem orçamento definido)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  invoiceItems  ErpInvoiceItem[]
  expenses      ErpExpense[]
  ledgerEntries FinancialLedger[]
  cashMovements CashMovement[]
}

/// Movimento de caixa — real ou projectado (ADR-025).
/// Populado por handlers do Event Bus após erp.payment.confirmed e erp.expense.paid.
/// isProjected=true: gerado por cron com base em RentSchedules e Expenses recorrentes.
model CashMovement {
  id           String             @id @default(cuid())
  date         DateTime
  type         CashMovementType
  amount       Float              // AOA — sempre positivo
  description  String
  source       CashMovementSource
  sourceId     String?            // ErpPayment.id | ErpExpense.id | etc.
  isProjected  Boolean            @default(false)
  bankAccount  String?            // ex.: "BCS-MAIN" | "BCS-POUPANCA"
  balance      Float              // saldo acumulado após este movimento
  costCenterId String?
  costCenter   CostCenter?        @relation(fields: [costCenterId], references: [id])
  createdBy    String             // AdminUser.id ou "SYSTEM"
  createdAt    DateTime           @default(now())

  @@index([date])
  @@index([type])
  @@index([isProjected])
  @@index([source])
}

/// Alerta financeiro automático ou manual.
/// Criado pelo cron diário ou por handlers de eventos.
/// Ciclo: ACTIVE → ACKNOWLEDGED → RESOLVED | SNOOZED → ACTIVE
model FinancialAlert {
  id              String        @id @default(cuid())
  type            AlertType
  severity        AlertSeverity @default(WARNING)
  status          AlertStatus   @default(ACTIVE)
  title           String
  message         String
  companyId       String?
  company         Company?      @relation(fields: [companyId], references: [id])
  invoiceId       String?       // ErpInvoice.id
  contractId      String?       // ErpContract.id
  expenseId       String?       // ErpExpense.id
  dueDate         DateTime?
  amount          Float?
  acknowledgedAt  DateTime?
  acknowledgedBy  String?       // AdminUser.id
  resolvedAt      DateTime?
  resolvedBy      String?
  snoozedUntil    DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status])
  @@index([type])
  @@index([severity])
  @@index([companyId])
}

/// Snapshot mensal de relatório financeiro.
/// Gerado pelo cron no final de cada mês. Imutável após geração.
/// Permite comparação histórica mesmo após rectificações nos dados base.
model FinancialReportSnapshot {
  id          String   @id @default(cuid())
  period      String   // "2026-07" (YYYY-MM)
  type        String   // "MONTHLY" | "QUARTERLY" | "ANNUAL"
  data        Json     // snapshot completo: { mrr, arr, revenue, expenses, profit, ... }
  generatedAt DateTime @default(now())
  generatedBy String   // "SYSTEM" | AdminUser.id

  @@unique([period, type])
  @@index([period])
}

// ═══════════════════════════════════════════════════════════════════════════════
// VOLUME 03 — PORTAL DO CLIENTE + COMUNICAÇÃO OMNICANAL
// Todos os modelos abaixo fazem parte do Portal (Sprint VOL03-1+, Ago 2026).
// Não modificar sem consultar docs/06-portal/data-model.md e docs/adr/README.md.
// ADRs relacionados: 026, 027, 028, 029, 030.
// Isolamento multi-tenant obrigatório: todas as queries DEVEM incluir companyId.
// ═══════════════════════════════════════════════════════════════════════════════

// ── Enums Portal ─────────────────────────────────────────────────────────────

/// Role de utilizador no portal do cliente.
/// PORTAL_OWNER: 1 por empresa, criado pelo admin.
/// PORTAL_ADMIN: max 3 por empresa.
/// PORTAL_MEMBER: ilimitado — pode criar reservas e tickets.
/// PORTAL_VIEWER: só leitura — não pode criar tickets nem reservas.
enum PortalRole {
  PORTAL_OWNER
  PORTAL_ADMIN
  PORTAL_MEMBER
  PORTAL_VIEWER
}

/// Estado do ciclo de vida de uma notificação.
/// Máquina de estados: PENDING → SENT → DELIVERED → READ | FAILED.
enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

/// Canal de comunicação omnicanal.
enum OmnichannelType {
  EMAIL
  WHATSAPP
  IN_APP
  PUSH_WEB
}

/// Estado do ciclo de vida de um ticket de suporte.
enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING
  RESOLVED
  CLOSED
}

/// Prioridade de ticket de suporte (SLA em horas úteis WAT).
/// LOW: 72h | NORMAL: 48h | HIGH: 24h | URGENT: 4h.
enum SupportTicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

/// Tipo de alerta/notificação do portal.
enum PortalAlertType {
  // Alertas automáticos (cron)
  RENT_DUE
  CONTRACT_EXPIRING
  PAYMENT_OVERDUE
  BOOKING_CONFIRMED
  DOCUMENT_AVAILABLE
  // Notificações transaccionais
  INVOICE_ISSUED
  PAYMENT_CONFIRMED
  BOOKING_RECEIVED
  TICKET_REPLY
  // Onboarding
  WELCOME
  USER_INVITED
}

/// Acção de auditoria sobre um documento do portal.
enum DocumentAccessAction {
  VIEW
  DOWNLOAD
  SIGNED_URL_GENERATED
  VERSION_VIEWED
}

/// Tipo de remetente de mensagem de suporte.
enum SupportMessageSender {
  CLIENT
  STAFF
}

// ── Modelos Portal ───────────────────────────────────────────────────────────

/// Utilizador do portal do cliente.
/// Separado de AdminUser — autenticação independente (cookie portal-session).
/// Regra: máximo 1 PORTAL_OWNER activo por empresa.
/// Regra: @@unique([companyId, email]) — email único por empresa.
model PortalUser {
  id             String     @id @default(cuid())
  companyId      String
  company        Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  email          String
  passwordHash   String?    // null se usar Magic Link apenas (ADR-026)
  name           String
  phone          String?
  role           PortalRole @default(PORTAL_MEMBER)
  isActive       Boolean    @default(true)
  isConfirmed    Boolean    @default(false)
  // Preferências de notificação
  notifyEmail    Boolean    @default(true)
  notifyWhatsapp Boolean    @default(false)  // requer opt-in explícito (Meta)
  notifyPush     Boolean    @default(true)
  notifyInApp    Boolean    @default(true)
  // Push Web (VAPID — ADR-027)
  pushEndpoint   String?
  pushP256dh     String?
  pushAuth       String?
  // Audit
  lastLoginAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  sessions       PortalSession[]
  magicLinks     PortalMagicLink[]
  notifications  PortalNotification[]
  docAccesses    PortalDocumentAccess[]
  ticketsCreated PortalSupportTicket[]

  @@unique([companyId, email])
  @@index([companyId])
  @@index([email])
  @@index([role])
  @@index([isActive])
}

/// Sessão autenticada de um PortalUser.
/// Cookie: portal-session (SEPARADO do cookie session do admin).
/// TTL: 8 horas. tokenHash = SHA-256 do JWT (nunca guardar o token bruto).
model PortalSession {
  id           String     @id @default(cuid())
  portalUserId String
  portalUser   PortalUser @relation(fields: [portalUserId], references: [id], onDelete: Cascade)
  tokenHash    String     @unique  // SHA-256 do token JWT
  expiresAt    DateTime
  isRevoked    Boolean    @default(false)
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime   @default(now())

  @@index([portalUserId])
  @@index([tokenHash])
  @@index([expiresAt])
}

/// Token de magic link para autenticação sem password (ADR-026).
/// 32 bytes aleatórios (hex = 64 chars), TTL 15 minutos, uso único.
/// Rate limit: máximo 3 por hora por email.
model PortalMagicLink {
  id           String     @id @default(cuid())
  portalUserId String
  portalUser   PortalUser @relation(fields: [portalUserId], references: [id], onDelete: Cascade)
  token        String     @unique  // hex de 32 bytes
  expiresAt    DateTime
  isUsed       Boolean    @default(false)
  usedAt       DateTime?
  ipAddress    String?
  createdAt    DateTime   @default(now())

  @@index([token])
  @@index([portalUserId])
  @@index([expiresAt])
}

/// Documento partilhado com o cliente.
/// Regra BR-PORT-002: nunca expor URL directa do Cloudinary.
/// Sempre gerar URL assinada com TTL 15 minutos.
/// Versões anteriores são imutáveis — nunca apagar.
model PortalDocument {
  id               String    @id @default(cuid())
  companyId        String
  company          Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title            String
  category         String    // contrato | fatura-manual | declaracao | comprovante | guia | outro
  description      String?
  tags             String[]
  currentVersionId String?   // PortalDocumentVersion.id da versão actual
  isActive         Boolean   @default(true)
  uploadedById     String?   // AdminUser.id ou PortalUser.id
  uploadedByName   String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  versions         PortalDocumentVersion[]
  accesses         PortalDocumentAccess[]

  @@index([companyId])
  @@index([category])
  @@index([isActive])
}

/// Versão imutável de um documento do portal.
/// Regra: NUNCA apagar versões — append-only.
/// cloudinaryPublicId: ID interno do Cloudinary (NUNCA URL directa).
model PortalDocumentVersion {
  id                 String         @id @default(cuid())
  documentId         String
  document           PortalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version            Int            // 1, 2, 3, ... (incrementa atomicamente)
  cloudinaryPublicId String         // ID Cloudinary — URL gerada on-demand assinada
  mimeType           String?
  sizeBytes          Int?
  changeNote         String?
  uploadedById       String?
  uploadedByName     String?
  createdAt          DateTime       @default(now())

  @@unique([documentId, version])
  @@index([documentId])
}

/// Auditoria de acesso a documentos — append-only.
/// Regra BR-PORT-003: toda leitura e download é registada.
/// NUNCA executar UPDATE ou DELETE nesta tabela.
model PortalDocumentAccess {
  id           String               @id @default(cuid())
  documentId   String
  document     PortalDocument       @relation(fields: [documentId], references: [id])
  portalUserId String
  portalUser   PortalUser           @relation(fields: [portalUserId], references: [id])
  versionId    String?
  action       DocumentAccessAction
  signedUrl    String?              // URL assinada gerada (para auditoria — pode ser longa)
  urlExpiresAt DateTime?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime             @default(now())

  @@index([documentId])
  @@index([portalUserId])
  @@index([action])
  @@index([createdAt])
  // Índice composto — VOL03-10C (Performance)
  @@index([documentId, createdAt])             // histórico de acesso por documento (paginado)
}

/// Notificação enviada a um utilizador do portal.
/// Regra BR-PORT-NOTIF-001: toda notificação tem estado final.
/// Motor de re-tentativas: max 3, backoff 5 min / 30 min (cron */5 * * * *).
/// Fallback: canal != EMAIL → tentar email se falhar.
model PortalNotification {
  id           String             @id @default(cuid())
  companyId    String
  company      Company            @relation(fields: [companyId], references: [id])
  portalUserId String?
  portalUser   PortalUser?        @relation(fields: [portalUserId], references: [id])
  type         PortalAlertType
  status       NotificationStatus @default(PENDING)
  channel      OmnichannelType
  title        String
  body         String
  actionUrl    String?
  // Timestamps de ciclo de vida
  sentAt       DateTime?
  deliveredAt  DateTime?
  readAt       DateTime?
  failedAt     DateTime?
  // Re-tentativas
  attempts     Int                @default(0)
  maxAttempts  Int                @default(3)
  nextRetryAt  DateTime?
  // Referências opcionais
  invoiceId    String?
  contractId   String?
  documentId   String?
  bookingId    String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([companyId])
  @@index([portalUserId])
  @@index([status])
  @@index([channel])
  @@index([type])
  @@index([nextRetryAt])
  // Índices compostos — VOL03-10C (Performance)
  @@index([portalUserId, status])              // unread count: WHERE portalUserId=X AND status IN (...)
  @@index([portalUserId, channel])             // SSE: in-app por utilizador
  @@index([status, nextRetryAt])               // cron retry: WHERE status=PENDING AND nextRetryAt<=now
  @@index([companyId, status, nextRetryAt])    // retry por empresa (monitoring)
}

/// Mensagem enviada via canal omnicanal — audit trail de entregas.
/// Um evento omnicanal pode gerar múltiplos OmnichannelMessage (um por canal tentado).
model OmnichannelMessage {
  id             String             @id @default(cuid())
  companyId      String
  channel        OmnichannelType
  recipient      String             // email | +244XXXXXXXXX | push endpoint URL
  body           String
  template       String?            // nome do template (WhatsApp/Email)
  status         NotificationStatus @default(PENDING)
  externalId     String?            // ID do provider (Resend ID, Meta message ID)
  notificationId String?            // PortalNotification.id associada
  sentAt         DateTime?
  deliveredAt    DateTime?
  failedReason   String?
  metadata       Json?              // response do provider, headers, etc.
  createdAt      DateTime           @default(now())

  @@index([companyId])
  @@index([channel])
  @@index([status])
  @@index([notificationId])
}

/// Ticket de suporte do cliente (ADR-029: suporte assíncrono, sem live chat).
/// Numeração: ST-YYYY-NNNNNN via DocumentCounter (prefix "ST").
/// SLA calculado em horas úteis (Mon-Fri, 08h-18h WAT).
model PortalSupportTicket {
  id          String                @id @default(cuid())
  number      String                @unique  // ST-2026-000001
  companyId   String
  company     Company               @relation(fields: [companyId], references: [id])
  createdById String
  createdBy   PortalUser            @relation(fields: [createdById], references: [id])
  subject     String                // máx 120 caracteres
  category    String                // faturacao | contrato | reservas | tecnico | outro
  priority    SupportTicketPriority @default(NORMAL)
  status      SupportTicketStatus   @default(OPEN)
  slaDeadline DateTime?             // createdAt + SLA(priority) em horas úteis WAT
  assignedTo  String?               // AdminUser.id (não FK — admin separado)
  resolvedAt  DateTime?
  closedAt    DateTime?
  reopenedAt  DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  messages    PortalSupportMessage[]

  @@index([companyId])
  @@index([status])
  @@index([priority])
  @@index([number])
  @@index([createdAt])
  // Índices compostos — VOL03-10C (Performance)
  @@index([companyId, status])                 // lista tickets: WHERE companyId=X AND status=Y
  @@index([companyId, status, updatedAt])      // auto-close cron: WAITING + updatedAt < 7d
  @@index([companyId, createdAt])              // histórico paginado por empresa
}

/// Mensagem de um ticket de suporte.
/// isInternal=true: nota interna do staff — NUNCA visível ao cliente.
/// senderType: CLIENT | STAFF — senderId pode ser PortalUser.id ou AdminUser.id.
model PortalSupportMessage {
  id          String               @id @default(cuid())
  ticketId    String
  ticket      PortalSupportTicket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  body        String
  isInternal  Boolean              @default(false)
  senderType  SupportMessageSender
  senderId    String               // PortalUser.id (CLIENT) ou AdminUser.id (STAFF)
  senderName  String               // denormalizado para auditoria
  attachments String[]             // Cloudinary URLs
  createdAt   DateTime             @default(now())

  @@index([ticketId])
  @@index([isInternal])
  @@index([createdAt])
}

// ═══════════════════════════════════════════════════════════════════════════════
// VOLUME 08 — GESTÃO DOCUMENTAL
// Modelos de geração e arquivo de documentos (propostas, contratos).
// Docs: docs/11-gestao-documental/README.md · ADR-038
// ═══════════════════════════════════════════════════════════════════════════════

/// Tipo de documento gerado pela plataforma.
enum DocumentTemplateType {
  PROPOSAL     // Proposta comercial (para leads/oportunidades)
  CONTRACT     // Contrato de alocação (para ErpContract)
  DECLARATION  // Declaração de coworker
  LETTER       // Carta genérica
}

/// Template editável de documento — VOL08.
/// version é imutável nos GeneratedDocument que o usaram (snapshot de templateVersion).
/// Regra: cada PATCH no htmlBody/subject incrementa version atomicamente.
/// Nunca decrementar version.
model DocumentTemplate {
  id           String               @id @default(cuid())
  slug         String               @unique
  name         String
  type         DocumentTemplateType
  description  String?
  htmlBody     String               @db.Text   // HTML com {{variáveis}} — editável pelo operador
  variables    String[]             // lista declarativa de variáveis esperadas
  version      Int                  @default(1) // incrementa a cada edição — auditoria de versões
  isActive     Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  generatedDocs GeneratedDocument[]

  @@index([type, isActive])
  @@index([slug])
}

/// Documento gerado e arquivado — VOL08.
/// IMUTÁVEL após criação. Regeneração cria novo registo (version + 1 por entidade).
/// sha256Hash permite verificação de integridade futura do ficheiro.
/// Falha de upload Cloudinary → registo NÃO é criado (ver document-generation-service.ts).
model GeneratedDocument {
  id              String               @id @default(cuid())
  templateSlug    String
  template        DocumentTemplate     @relation(fields: [templateSlug], references: [slug])
  templateVersion Int                  // snapshot imutável de DocumentTemplate.version no momento da geração
  type            DocumentTemplateType
  entityType      String               // "LEAD" | "ERPCONTRACT" | "COMPANY"
  entityId        String               // id da entidade associada
  version         Int                  @default(1) // versão por (entityType, entityId, templateSlug): 1, 2, 3...
  cloudinaryId    String               // public_id Cloudinary — imutável após geração
  fileName        String               // ex: "proposta-azul-2026-000001-v1.pdf"
  fileSizeBytes   Int
  sha256Hash      String               // SHA-256 hex do buffer PDF — integridade documental
  generatedBy     String               // AdminUser.id
  generatedAt     DateTime             @default(now()) // timestamp explícito de geração (auditável)
  createdAt       DateTime             @default(now())

  @@index([entityType, entityId])
  @@index([entityType, entityId, templateSlug])   // versioning: MAX(version) por entidade+template
  @@index([templateSlug])
  @@index([createdAt])
  @@index([generatedBy])
}

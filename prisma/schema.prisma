// Schema pronto para SQLite (dev/local) e Postgres/Supabase (produção).
// Para produção: troque provider para "postgresql" e use a DATABASE_URL do Supabase.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Lead {
  id              String   @id @default(cuid())
  firstName       String
  lastName        String
  email           String
  whatsapp        String
  scheduledDate   DateTime
  status          String   @default("NOVO")
  notes           Note[]
  source          String?    @default("landing-page")
  ip              String?
  appointmentTime String?
  appointmentType String?  @default("Pedido de contacto")
  company         String?
  spaceType       String?
  planName        String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([status])
  @@index([scheduledDate])
  @@index([createdAt])
}

model RoomBookingLead {
  id              String    @id @default(cuid())
  firstName       String
  lastName        String
  company         String?
  email           String
  whatsapp        String
  planName        String
  participants    Int?
  preferredDate   DateTime?
  preferredTime   String?
  observations    String?
  coffeeBreak     Boolean   @default(false)
  status          String    @default("NOVO")
  source          String    @default("landing-sala")
  ip              String?
  companyId       String?
  reservationId   String?
  convertedAt     DateTime?
  convertedBy     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([planName])
}

model Note {
  id        String   @id @default(cuid())
  content   String
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         String   @default("ADMIN")
  totpSecret   String?
  totpEnabled  Boolean  @default(false)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model DeleteRequest {
  id          String   @id @default(cuid())
  requestedBy String
  entityType  String
  entityId    String
  entityLabel String
  reason      String
  status      String   @default("PENDING")
  reviewedBy  String?
  reviewNote  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Company {
  id                String             @id @default(cuid())
  name              String
  nif               String?
  responsible       String
  email             String
  whatsapp          String
  roomNumber        String
  numEmployees      Int                @default(1)
  planType          String
  contractStart     DateTime
  contractEnd       DateTime
  rentAmount        Float
  paymentFrequency  String             @default("MENSAL")
  contractStatus    String             @default("ATIVO")
  paymentStatus     String             @default("EM_DIA")
  contractFileUrl   String?
  notes             String?
  leadSourceId      String?
  payments          Payment[]
  invoices          Invoice[]
  financialHistory  FinancialHistory[]
  reservations      Reservation[]
  timeline          Timeline[]
  liquidationNotes  LiquidationNote[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([contractStatus])
  @@index([contractEnd])
}


model Payment {
  id              String    @id @default(cuid())
  companyId       String?
  company         Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reservationId   String?   // link to sala reservation (optional)
  dueDate         DateTime
  paidDate        DateTime?
  amount          Float
  status          String    @default("PENDENTE")
  notes           String?
  invoiceId       String?
  paymentMethod   String?
  receiptUrl      String?   // doc 1 — comprovativo
  doc2Url         String?   // doc 2 — opcional
  category        String?
  receiptNumber   String?   // REC-YYYY-NNNNNN gerado automaticamente
  operationRef    String?   // referência bancária / multicaixa / POS
  previousBalance Float?    // saldo antes deste pagamento (auditoria)
  createdAt       DateTime  @default(now())

  @@index([companyId])
  @@index([status])
  @@index([dueDate])
  @@index([receiptNumber])
  @@index([reservationId])
}

model Invoice {
  id              String           @id @default(cuid())
  invoiceNumber   String           @unique
  companyId       String?
  company         Company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reservationId   String?          // link to sala reservation (optional)
  serviceType     String
  amount          Float
  discount        Float            @default(0)
  iva             Float            @default(0)  // percentage
  totalAmount     Float            @default(0)
  amountPaid      Float            @default(0)
  balance         Float            @default(0)
  paidPercentage  Float            @default(0)
  issueDate       DateTime         @default(now())
  dueDate         DateTime
  paymentMethod   String?
  status          String           @default("PENDENTE")
  // PENDENTE | PARCIAL | LIQUIDADA | EM_ATRASO | PAGO
  receiptUrl      String?
  notes           String?
  invoicePayments InvoicePayment[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([companyId])
  @@index([status])
  @@index([dueDate])
  @@index([reservationId])
}

model InvoicePayment {
  id            String   @id @default(cuid())
  invoiceId     String
  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount        Float
  paymentMethod String?
  operationRef  String?
  receiptUrl    String?
  paidDate      DateTime @default(now())
  createdBy     String?
  createdAt     DateTime @default(now())

  @@index([invoiceId])
}

model LiquidationNote {
  id            String   @id @default(cuid())
  noteNumber    String   @unique
  invoiceId     String?
  reservationId String?
  companyId     String?
  company       Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  amountBilled  Float
  amountPaid    Float
  balance       Float
  paymentMethod String?
  operationRef  String?
  createdBy     String?
  createdAt     DateTime @default(now())

  @@index([invoiceId])
  @@index([companyId])
}

model FinancialAudit {
  id          String   @id @default(cuid())
  action      String
  entityType  String
  entityId    String
  companyId   String?
  amount      Float?
  method      String?
  reference   String?
  createdBy   String?
  ip          String?
  createdAt   DateTime @default(now())

  @@index([entityId])
  @@index([companyId])
  @@index([createdAt])
}

model FinancialHistory {
  id             String   @id @default(cuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type           String   // PAGAMENTO | FATURA | AJUSTE | NOTA
  description    String
  amount         Float
  runningBalance Float    @default(0)
  method         String?
  reference      String?  // paymentId or invoiceId
  createdBy      String?
  createdAt      DateTime @default(now())

  @@index([companyId])
  @@index([createdAt])
}

model Expense {
  id          String   @id @default(cuid())
  category    String
  description String
  amount      Float
  expenseDate DateTime
  supplier    String?
  status      String   @default("PAGO")
  receiptUrl  String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([expenseDate])
}

model RevenueCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model MeetingPlan {
  id                    String        @id @default(cuid())
  name                  String
  maxPeople             Int
  description           String?
  coffeeBreakAvailable  Boolean       @default(true)
  customPricingAllowed  Boolean       @default(false)
  minHoursForCustom     Int?          @default(16)
  pricePerHour          Float         @default(0)
  coffeeBreakPrice      Float         @default(0)
  halfDayPrice          Float         @default(0)   // 4h flat price
  fullDayPrice          Float         @default(0)   // 8h flat price
  weekendPrice          Float         @default(0)   // weekend flat price
  promoPrice            Float         @default(0)   // promotional price
  active                Boolean       @default(true)
  reservations          Reservation[]
  createdAt             DateTime      @default(now())
}

model Reservation {
  id                String      @id @default(cuid())
  reservationNumber String?     // RES-YYYY-NNNNNN

  // Dados do cliente
  eventName         String
  companyName       String?     // free-text (external clients)
  companyId         String?     // link to Company (coworking members)
  company           Company?    @relation(fields: [companyId], references: [id], onDelete: SetNull)
  responsible       String
  email             String?
  whatsapp          String?

  // Plano e horário
  planId            String
  plan              MeetingPlan @relation(fields: [planId], references: [id])
  participants      Int
  startDatetime     DateTime
  endDatetime       DateTime
  totalHours        Float
  coffeeBreak       Boolean     @default(false)
  observations      String?

  // Estado da reserva
  status            String      @default("CONFIRMADA")
  // CONFIRMADA | RESERVADO | PENDENTE_APROVACAO | CANCELADA | CONCLUIDA
  isCustomPricing   Boolean     @default(false)
  customRequest     String?

  // Financeiro
  paymentOption     String      @default("PAGAR_NO_DIA")
  // PAGAR_AGORA | PAGAR_NO_DIA | FACTURAR | ISENTO
  amount            Float       @default(0)   // base (hours × pricePerHour + coffeeBreak)
  discount          Float       @default(0)   // discount amount
  iva               Float       @default(0)   // IVA % (e.g. 14)
  totalAmount       Float       @default(0)   // final amount
  paymentStatus     String      @default("PENDENTE")
  // PAGO | PENDENTE | FACTURADO | ISENTO
  paymentMethod     String?
  operationRef      String?
  receiptUrl        String?
  financialNotes    String?
  amountPaid        Float       @default(0)   // amount paid so far (partial support)
  paidDate          DateTime?                  // date of payment

  // Linked financial records
  paymentId         String?
  invoiceId         String?
  roomBookingLeadId String?

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([planId])
  @@index([companyId])
  @@index([startDatetime])
  @@index([status])
  @@index([paymentStatus])
  @@index([reservationNumber])
}

model Timeline {
  id            String   @id @default(cuid())
  companyId     String?
  company       Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  leadId        String?
  type          String
  title         String
  description   String?
  amount        Float?
  referenceId   String?
  referenceType String?
  createdBy     String?
  createdAt     DateTime @default(now())

  @@index([companyId])
  @@index([leadId])
  @@index([createdAt])
}

model RoomSettings {
  id                  String   @id @default(cuid())
  defaultPricePerHour Float    @default(15000)
  defaultHalfDay      Float    @default(50000)
  defaultFullDay      Float    @default(90000)
  defaultWeekend      Float    @default(120000)
  defaultIva          Float    @default(0)
  maxDiscount         Float    @default(100)
  currency            String   @default("AOA")
  openTime            String   @default("08:00")
  closeTime           String   @default("18:00")
  minHours            Float    @default(1)
  maxHours            Float    @default(12)
  updatedAt           DateTime @updatedAt
  updatedBy           String?
}

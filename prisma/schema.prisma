  QUALIFICATION
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum ContactRole {
  DECISION_MAKER
  INFLUENCER
  CHAMPION
  END_USER
  BILLING
  TECHNICAL
  OTHER
}

enum ActivityType {
  CALL
  EMAIL
  MEETING
  VISIT
  DEMO
  WHATSAPP
  OTHER
}

enum ActivityDirection {
  INBOUND
  OUTBOUND
}

enum TaskPriority {

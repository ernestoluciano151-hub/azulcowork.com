// Schema pronto para SQLite (dev/local) e Postgres/Supabase (produção).
// Para produção: troque provider para "postgresql" e use a DATABASE_URL do Supabase.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Lead {
  id              String   @id @default(cuid())
  firstName       String
  lastName        String
  email           String
  whatsapp        String
  scheduledDate   DateTime
  status          String   @default("NOVO")
  notes           Note[]
  source          String?    @default("landing-page")
  ip              String?
  appointmentTime String?
  appointmentType String?  @default("Pedido de contacto")
  company         String?
  spaceType       String?
  planName        String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([status])
  @@index([scheduledDate])
  @@index([createdAt])
}

model RoomBookingLead {
  id              String   @id @default(cuid())
  firstName       String
  lastName        String
  company         String?
  email           String
  whatsapp        String
  planName        String
  participants    Int?
  preferredDate   DateTime?
  preferredTime   String?
  observations    String?
  coffeeBreak     Boolean  @default(false)
  status          String   @default("NOVO")
  source          String   @default("landing-sala")
  ip              String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([planName])
}

model Note {
  id        String   @id @default(cuid())
  content   String
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         String   @default("ADMIN")
  totpSecret   String?
  totpEnabled  Boolean  @default(false)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model DeleteRequest {
  id          String   @id @default(cuid())
  requestedBy String
  entityType  String
  entityId    String
  entityLabel String
  reason      String
  status      String   @default("PENDING")
  reviewedBy  String?
  reviewNote  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Company {
  id               String        @id @default(cuid())
  name             String
  nif              String?
  responsible      String
  email            String
  whatsapp         String
  roomNumber       String
  numEmployees     Int           @default(1)
  planType         String
  contractStart    DateTime
  contractEnd      DateTime
  rentAmount       Float
  contractStatus   String        @default("ATIVO")
  paymentStatus    String        @default("EM_DIA")
  contractFileUrl  String?
  notes            String?
  payments         Payment[]
  invoices         Invoice[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([contractStatus])
  @@index([contractEnd])
}

model Payment {
  id            String    @id @default(cuid())
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  dueDate       DateTime
  paidDate      DateTime?
  amount        Float
  status        String    @default("PENDENTE")
  notes         String?
  invoiceId     String?
  paymentMethod String?
  receiptUrl    String?
  category      String?
  createdAt     DateTime  @default(now())

  @@index([companyId])
  @@index([status])
  @@index([dueDate])
}

model Invoice {
  id            String    @id @default(cuid())
  invoiceNumber String    @unique
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  serviceType   String
  amount        Float
  issueDate     DateTime  @default(now())
  dueDate       DateTime
  paymentMethod String?
  status        String    @default("PENDENTE")
  receiptUrl    String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([companyId])
  @@index([status])
  @@index([dueDate])
}

model Expense {
  id          String   @id @default(cuid())
  category    String
  description String
  amount      Float
  expenseDate DateTime
  supplier    String?
  status      String   @default("PAGO")
  receiptUrl  String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([expenseDate])
}

model RevenueCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model MeetingPlan {
  id                    String        @id @default(cuid())
  name                  String
  maxPeople             Int
  description           String?
  coffeeBreakAvailable  Boolean       @default(true)
  customPricingAllowed  Boolean       @default(false)
  minHoursForCustom     Int?          @default(16)
  active                Boolean       @default(true)
  reservations          Reservation[]
  createdAt             DateTime      @default(now())
}

model Reservation {
  id              String      @id @default(cuid())
  eventName       String
  companyName     String?
  responsible     String
  planId          String
  plan            MeetingPlan @relation(fields: [planId], references: [id])
  participants    Int
  startDatetime   DateTime
  endDatetime     DateTime
  totalHours      Float
  coffeeBreak     Boolean     @default(false)
  observations    String?
  status          String      @default("CONFIRMADA")
  isCustomPricing Boolean     @default(false)
  customRequest   String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([planId])
  @@index([startDatetime])
  @@index([status])
}

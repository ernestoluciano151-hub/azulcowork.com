  ERP_INVOICE_SENT
  ERP_INVOICE_PAID
  ERP_INVOICE_OVERDUE
  ERP_INVOICE_VOIDED
  // ERP — Pagamentos (Volume 02)
  ERP_PAYMENT_CONFIRMED
  ERP_PAYMENT_REJECTED
  ERP_PAYMENT_REFUNDED
  ERP_RECEIPT_GENERATED
  // ERP — Despesas (Volume 02)
  EXPENSE_APPROVED
  EXPENSE_PAID
  // ERP — Alertas (Volume 02)
  FINANCIAL_ALERT_CREATED
  FINANCIAL_ALERT_RESOLVED
  // Portal — Volume 03
  PORTAL_USER_INVITED
  PORTAL_USER_ACTIVATED
  PORTAL_USER_DEACTIVATED
  PORTAL_DOCUMENT_UPLOADED
  PORTAL_DOCUMENT_DOWNLOADED
  PORTAL_DOCUMENT_VIEWED
  PORTAL_NOTIFICATION_SENT
  PORTAL_TICKET_CREATED
  PORTAL_TICKET_REPLIED
  PORTAL_TICKET_RESOLVED
  PORTAL_TICKET_CLOSED
}

// ── Modelos CRM ──────────────────────────────────────────────────────────────

/// Contacto associado a uma empresa (pessoa física).
/// Regra: isPrimary = true só pode existir um por empresa.
model CrmContact {
  id          String      @id @default(cuid())
  companyId   String
  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  firstName   String
  lastName    String
  email       String?
  phone       String?
  role        ContactRole @default(OTHER)
  isPrimary   Boolean     @default(false)
  linkedInUrl String?
  notes       String?
  deletedAt   DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([companyId])
  @@index([email])
  @@index([companyId, isPrimary])
}

/// Oportunidade comercial (Deal).
/// Regra BR-PIPE-005: máximo 1 deal em NEGOTIATION por empresa.
/// Regra BR-PIPE-006: discountPct > 10 exige approvedBy (ADMIN).
/// Regra BR-PIPE-007: stage = LOST exige lostReason.
model CrmDeal {
  id            String    @id @default(cuid())
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title         String
  stage         DealStage @default(DISCOVERY)
  value         Float?
  currency      String    @default("AOA")
  probability   Int?      // 0–100
  expectedClose DateTime?
  lostReason    String?
  assignedToId  String?
  approvedBy    String?   // AdminUser.id — desconto > 10%
  discountPct   Float     @default(0)
  closedAt      DateTime?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([companyId])
  @@index([stage])
  @@index([assignedToId])
  @@index([expectedClose])
  @@index([companyId, stage])
}

/// Registo de interacção comercial (chamada, email, reunião, etc.).
model CrmActivity {
  id          String            @id @default(cuid())
  companyId   String
  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type        ActivityType
  direction   ActivityDirection @default(OUTBOUND)
  title       String
  description String?
  durationMin Int?
  contactId   String?           // CrmContact.id (optional)
  dealId      String?           // CrmDeal.id (optional)
  createdById String?           // AdminUser.id
  occurredAt  DateTime          @default(now())
  createdAt   DateTime          @default(now())

  @@index([companyId])
  @@index([type])
  @@index([occurredAt])
  @@index([dealId])
}

/// Tarefa de follow-up.
/// Regra BR-CRM-010: tasks vencidas > 24h publicam crm.task.overdue no Event Bus.
model CrmTask {
  id           String       @id @default(cuid())
  companyId    String
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  priority     TaskPriority @default(MEDIUM)
  status       TaskStatus   @default(PENDING)
  dueDate      DateTime?
  completedAt  DateTime?
  assignedToId String?      // AdminUser.id
  dealId       String?      // CrmDeal.id (optional)
  contactId    String?      // CrmContact.id (optional)
  createdById  String?      // AdminUser.id
  deletedAt    DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([companyId])
  @@index([status])
  @@index([assignedToId])
  @@index([dueDate])
  @@index([companyId, status])
}

/// Nota interna sobre uma empresa (distingue-se de Note que pertence a Lead).
model CrmNote {
  id        String    @id @default(cuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  content   String
  authorId  String?   // AdminUser.id
  dealId    String?   // CrmDeal.id (optional)
  contactId String?   // CrmContact.id (optional)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([companyId])
  @@index([authorId])
}

/// Tag global (categorização de empresas).
model Tag {
  id          String       @id @default(cuid())
  name        String       @unique
  color       String?
  createdAt   DateTime     @default(now())
  companyTags CompanyTag[]
}

/// Associação muitos-para-muitos Company ↔ Tag.
model CompanyTag {
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tagId      String
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())
  assignedBy String?  // AdminUser.id

  @@id([companyId, tagId])
  @@index([tagId])
}

/// Historial cronológico de uma empresa — append-only.
/// Regra: NUNCA executar UPDATE ou DELETE nesta tabela.
/// Escrita exclusivamente pelos handlers do Event Bus.
model TimelineEntry {
  id               String            @id @default(cuid())
  companyId        String
  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  eventType        TimelineEventType
  title            String
  description      String?
  metadata         Json              @default("{}")
  actorId          String?           // AdminUser.id ou "system"
  actorName        String?
  isSystem         Boolean           @default(false)
  linkedEntityType String?           // "CrmDeal" | "CrmTask" | "Invoice" | etc.
  linkedEntityId   String?
  occurredAt       DateTime          @default(now())
  createdAt        DateTime          @default(now())

  @@index([companyId, occurredAt(sort: Desc)])
  @@index([eventType])
  @@index([occurredAt])
}

/// Log de auditoria do CRM — append-only.
/// Regra: NUNCA executar UPDATE ou DELETE nesta tabela.
model CrmAuditLog {
  id         String   @id @default(cuid())
  companyId  String?
  company    Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  action     String   // CREATE | UPDATE | DELETE | MERGE | STAGE_CHANGE | etc.
  entityType String   // Company | CrmDeal | CrmContact | etc.
  entityId   String
  actorId    String?  // AdminUser.id
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([companyId])
  @@index([entityId])
  @@index([createdAt])
  @@index([actorId])
}


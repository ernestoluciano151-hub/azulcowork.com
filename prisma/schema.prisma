// ── Enums ERP ────────────────────────────────────────────────────────────────

enum ContractStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  TERMINATED
  EXPIRED
  CANCELLED
}

enum ContractPlanType {
  FLEX
  HOT_DESK
  DEDICATED
  PRIVATE_OFFICE
  VIRTUAL
  CUSTOM

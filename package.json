{
  "name": "leadgen-crm",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build:pdf-worker": "node pdf-workers/build.mjs",
    "build": "npm run build:pdf-worker && next build",
    "build:prod": "prisma migrate deploy && npm run build:pdf-worker && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@prisma/client": "^5.18.0",
    "@react-pdf/renderer": "^4.5.1",
    "@sentry/nextjs": "^8.55.2",
    "@types/pdfkit": "^0.17.6",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.10.0",
    "date-fns": "^3.6.0",
    "exceljs": "^4.4.0",
    "jose": "^5.6.3",
    "nanoid": "^3.3.16",
    "next": "^15.2.5",
    "nodemailer": "^9.0.1",
    "otpauth": "^9.5.1",
    "pdfkit": "^0.19.1",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-is": "^19.2.7",
    "recharts": "^3.9.0",
    "web-push": "^3.6.7",
    "zod": "^3.25.76"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^18.3.0",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.19",
    "esbuild": "^0.28.2",
    "postcss": "^8.4.38",
    "prisma": "^5.18.0",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.10"
  }
}

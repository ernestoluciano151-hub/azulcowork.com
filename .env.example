# =============================================================================
# VD Platform — Variáveis de Ambiente
# Azul Coworking · Bairro Azul, Edifício 18 · Luanda, Angola
# =============================================================================
# INSTRUÇÕES:
#  1. Copie este ficheiro para .env.local (desenvolvimento) ou configure
#     as variáveis directamente no painel Vercel (produção).
#  2. NUNCA faça commit de .env.local ou .env.production com valores reais.
#  3. Em produção use sempre PostgreSQL — SQLite é apenas para dev local.
# =============================================================================


# ── Base de Dados ─────────────────────────────────────────────────────────────

# Desenvolvimento local (SQLite — zero configuração)
DATABASE_URL="file:./dev.db"

# Produção (PostgreSQL — Supabase, Neon, Railway, etc.)
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public&sslmode=require"


# ── Autenticação Admin ────────────────────────────────────────────────────────

# Email e password do utilizador admin inicial (criado pelo seed)
ADMIN_EMAIL="admin@azulcowork.com"
ADMIN_PASSWORD="MudeEstaSenha123!"

# Secret para assinar JWTs de sessão admin
# Gerar com: openssl rand -base64 64
JWT_SECRET="troque-este-segredo-por-uma-string-aleatoria-bem-longa-minimo-32-chars"

# Secret exclusivo para sessões do Portal do Cliente (recomendado)
# Se ausente, usa JWT_SECRET + ":portal" como fallback (menos seguro)
# Gerar com: openssl rand -base64 64
PORTAL_JWT_SECRET="outro-segredo-exclusivo-para-o-portal-do-cliente"


# ── URL da Aplicação ──────────────────────────────────────────────────────────

# URL pública — usada em links de emails (magic link, faturas, etc.)
# Desenvolvimento: http://localhost:3000
# Produção: https://app.azulcowork.com  (ou domínio Vercel)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# URL pública do site (marketing / landing page)
NEXT_PUBLIC_SITE_URL="https://www.azulcowork.com"

# Nome do site (exibido em títulos e emails)
NEXT_PUBLIC_SITE_NAME="Azul Coworking"


# ── Cron Jobs (Vercel Cron) ───────────────────────────────────────────────────

# Secret para autenticar pedidos dos 11 cron jobs
# Gerar com: openssl rand -hex 32
# Configurar também em Vercel → Settings → Environment Variables
CRON_SECRET="gerar-um-segredo-aleatorio-aqui"


# ── Email (SMTP / nodemailer) ─────────────────────────────────────────────────

# Configuração SMTP para emails transaccionais (magic link, faturas, boas-vindas, etc.)
# Providers sugeridos: Brevo (antigo Sendinblue), Mailgun, Gmail SMTP
SMTP_HOST="smtp.brevo.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="seu-email@dominio.com"
SMTP_PASS="sua-password-smtp"
SMTP_FROM="\"Azul Coworking\" <noreply@azulcowork.com>"

# Resend (alternativa ao SMTP — usado por módulos legados)
# Obter em: https://resend.com
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="noreply@azulcowork.com"


# ── Cloudinary (Upload de Ficheiros e PDFs) ───────────────────────────────────

# Obter em: https://cloudinary.com → Dashboard → API Keys
CLOUDINARY_CLOUD_NAME="seu-cloud-name"
CLOUDINARY_API_KEY="000000000000000"
CLOUDINARY_API_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Variável pública (usada no frontend para uploads directos se necessário)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="seu-cloud-name"


# ── Web Push Notifications (VAPID) ───────────────────────────────────────────

# Gerar par de chaves VAPID:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY="Bxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
VAPID_PRIVATE_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
VAPID_EMAIL="mailto:geral@azulcowork.com"


# ── WhatsApp Business API (Meta) ──────────────────────────────────────────────

# Obter em: https://developers.facebook.com → WhatsApp → API Setup
META_WHATSAPP_TOKEN="EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
META_WHATSAPP_PHONE_ID="000000000000000"
WHATSAPP_API_URL="https://graph.facebook.com/v18.0"
WHATSAPP_API_TOKEN="EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"


# ── Configurações de Operação ─────────────────────────────────────────────────

# Horas de operação diária das salas de reunião (cálculos de disponibilidade)
# Padrão: 10 horas (08:00–18:00 Africa/Luanda)
ROOM_DAILY_HOURS="10"


# ── Sentry — Error Monitoring ─────────────────────────────────────────────────

# Obter em: https://sentry.io → Project Settings → Client Keys (DSN)
SENTRY_DSN="https://xxxx@xxxx.ingest.sentry.io/xxxx"
NEXT_PUBLIC_SENTRY_DSN="https://xxxx@xxxx.ingest.sentry.io/xxxx"
SENTRY_AUTH_TOKEN="sntrys_xxxx"


# ── Vturb / ConvertAI (VSL — Landing Page) ───────────────────────────────────

# Obter no painel Vturb → Players → Embed Code
NEXT_PUBLIC_VTURB_PLAYER_ID="seu-player-id-vturb"
NEXT_PUBLIC_VTURB_SCRIPT_URL="https://scripts.converteai.net/SEU-ACCOUNT/players/SEU-PLAYER/player.js"
